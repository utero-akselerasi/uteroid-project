# CMS Artikel — Public Read API (server-side only)
#
# Copy to .env.local for `next dev` / `next build`, or to .env for
# docker compose. Both are gitignored.
#
# Never use a NEXT_PUBLIC_ prefix for the key: that inlines it into the
# browser bundle. All CMS requests go through Server Components in
# lib/cms/, which import "server-only" to enforce this.
#
# Get the key from https://cms.carubra.com/api-keys — the full value is
# shown exactly once. Rotate from that page if it is lost.

ARTIKEL_API_URL=https://cms.carubra.com/api/v1
ARTIKEL_API_KEY=ak_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Leaving ARTIKEL_API_KEY unset is a supported state: /insights falls back
# to the four local entries in lib/insights.ts.

# Google tracking and Search Console (public identifiers; set before building).
# GA4 is installed directly in <head>. Keep it out of GTM to prevent duplicate pageviews.
# GTM remains available for other tags and triggers.
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-search-console-meta-token
